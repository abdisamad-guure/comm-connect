NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/community-connect
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
# Used by `npm run seed` to create the initial administrator. Change these before production.
ADMIN_EMAIL=admin@communityconnect.local
ADMIN_PASSWORD=CommunityConnect!2026
# Comma-separated frontend origins. Leave blank during local development to allow all origins.
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173